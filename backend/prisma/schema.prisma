generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  WAITING
  ACTIVE
  QUESTION_ACTIVE
  BETWEEN_QUESTIONS
  FINISHED
  CLOSED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

model Quiz {
  id        String     @id @default(cuid())
  title     String
  status    QuizStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
  rooms     Room[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  order         Int
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  timeLimit     Int      @default(20)
  basePoints    Int      @default(100)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@unique([quizId, order])
  @@index([quizId])
}

model Room {
  id                String        @id @default(cuid())
  roomCode          String        @unique
  quizId            String
  status            RoomStatus    @default(WAITING)
  currentQuestion   Int           @default(0)
  questionStartedAt DateTime?
  questionEndsAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  quiz              Quiz          @relation(fields: [quizId], references: [id])
  participants      Participant[]
  results           Result[]

  @@index([quizId])
}

model Participant {
  id        String   @id @default(cuid())
  name      String
  phone     String   // <-- NEW FIELD
  roomId    String
  sessionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers   Answer[]
  result    Result?

  @@unique([roomId, phone])     // <-- NEW CONSTRAINT: Prevents same phone in the same room
  @@unique([roomId, sessionId]) // Prevents same browser session in the same room
  @@index([roomId])
}

model Answer {
  id             String      @id @default(cuid())
  participantId  String
  questionId     String
  selectedOption String
  submittedAt    DateTime    @default(now())
  responseTime   Int
  isCorrect      Boolean
  score          Int
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([questionId])
}

model Result {
  id             String      @id @default(cuid())
  roomId         String
  participantId  String      @unique
  totalScore     Int
  correctAnswers Int
  totalTime      Int
  rank           Int
  createdAt      DateTime    @default(now())
  room           Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([roomId, rank])
}